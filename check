#!/usr/bin/env bash
#
# Run what CI runs.
#
# This used to list the commands itself, which made it a second source of truth
# beside the workflow -- and two sources drift, reliably in the direction where
# local passes and CI does not, discovered after pushing. It now delegates to
# scripts/ci-local, which reads .github/workflows/ci.yml and runs its steps.
#
#   ./check              # the jobs that make sense on this machine
#   ./check --list       # what it would run, without running it
set -euo pipefail
exec "$(dirname "${BASH_SOURCE[0]}")/scripts/ci-local" "$@"
